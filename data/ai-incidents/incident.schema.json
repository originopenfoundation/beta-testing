{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://originopenfoundation.org/data/ai-incidents/incident.schema.json",
  "title": "OOFIncidentRecord",
  "type": "object",
  "required": ["id", "slug", "title", "eventType", "evidenceConfidence", "publicationStatus", "sources", "createdAt", "updatedAt"],
  "properties": {
    "id": {"type": "string", "pattern": "^OOF-AII-[0-9]{6}$"},
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "title": {"type": "string", "minLength": 1},
    "summary": {"type": "string"},
    "eventType": {"enum": ["Incident", "Hazard", "Near Miss", "Emerging Risk"]},
    "occurredAt": {"type": ["string", "null"], "format": "date-time"},
    "reportedAt": {"type": ["string", "null"], "format": "date-time"},
    "updatedAt": {"type": "string", "format": "date-time"},
    "createdAt": {"type": "string", "format": "date-time"},
    "country": {"type": ["string", "null"]},
    "countryCode": {"type": ["string", "null"], "pattern": "^[A-Z]{2}$"},
    "region": {"type": ["string", "null"]},
    "coordinates": {
      "type": ["object", "null"],
      "required": ["latitude", "longitude"],
      "properties": {
        "latitude": {"type": "number", "minimum": -90, "maximum": 90},
        "longitude": {"type": "number", "minimum": -180, "maximum": 180}
      },
      "additionalProperties": false
    },
    "organization": {"type": ["string", "null"]},
    "system": {"type": ["string", "null"]},
    "technology": {"type": ["string", "null"]},
    "industry": {"type": ["string", "null"]},
    "aiSystemType": {"type": ["string", "null"]},
    "severity": {"enum": ["Low", "Moderate", "High", "Critical", "Unclassified"]},
    "impactTypes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "affectedParties": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "evidenceConfidence": {"enum": ["Verified", "High Confidence", "Moderate Confidence", "Unverified"]},
    "verificationState": {"type": "string"},
    "publicationStatus": {"enum": ["Monitored", "Pending Review", "Published", "Withheld"]},
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["sourceId", "publisher", "url", "retrievedAt"],
        "properties": {
          "sourceId": {"type": "string"},
          "publisher": {"type": "string"},
          "publicationDate": {"type": ["string", "null"]},
          "sourceType": {"type": ["string", "null"]},
          "url": {"type": "string", "format": "uri"},
          "retrievedAt": {"type": "string", "format": "date-time"},
          "verificationStatus": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "architectureRelevance": {
      "type": "object",
      "properties": {
        "status": {"enum": ["ARCHITECTURE_IDENTIFIED", "ARCHITECTURE_REVIEW_REQUIRED", "NO_ARCHITECTURE_IDENTIFIED", "NOT_ASSESSED"]},
        "classification": {"enum": ["Automated", "Human Approved", "Not Assessed"]},
        "primaryArchitectureId": {"type": ["string", "null"]},
        "secondaryArchitectureIds": {"type": "array", "items": {"type": "string"}},
        "architectureIndexState": {"type": ["string", "null"]},
        "classifiedAt": {"type": ["string", "null"]},
        "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "rationale": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "assessment": {
      "type": ["object", "null"],
      "properties": {
        "status": {"enum": ["Pending Review", "Approved", "Rejected", "Modified"]},
        "coverage": {"enum": ["COVERED", "PARTIALLY_COVERED", "POTENTIAL_GOVERNANCE_GAP", "UNDER_REVIEW"]},
        "version": {"type": "string"},
        "lastUpdated": {"type": "string"},
        "finding": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
